# ===================================================
# LINKVAULT ENVIRONMENT CONFIGURATION
# ===================================================

PORT=4317
HOST=127.0.0.1
LINKVAULT_DB=data/linkvault.db
LINKVAULT_ENDPOINT=http://localhost:4317

# ===================================================
# RAPBOT GATEWAY INTEGRATION
# ===================================================
# URL server RapBot (default: http://localhost:3001)
RAPBOT_URL=http://localhost:3001

# API Secret Token dari Dashboard RapBot (Menu API & Webhook -> Buat API Key)
RAPBOT_API_TOKEN=rap_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
